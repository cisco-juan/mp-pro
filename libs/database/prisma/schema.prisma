generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Placeholder fase 1 — health check del API.
model HealthCheck {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")

  @@map("health_checks")
}

model Role {
  id          String   @id @default(cuid())
  nombre      String
  descripcion String   @default("")
  permisos    String[]
  users       User[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("roles")
}

model User {
  id                String         @id @default(cuid())
  nombre            String
  email             String         @unique
  telefono          String?
  passwordHash      String         @map("password_hash")
  activo            Boolean        @default(true)
  ordenesActivas    Int            @default(0) @map("ordenes_activas")
  passwordChangedAt DateTime?      @map("password_changed_at")
  roleId            String         @map("role_id")
  role              Role           @relation(fields: [roleId], references: [id], onDelete: Restrict)
  refreshTokens     RefreshToken[]
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  @@index([roleId])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

enum ClienteEstado {
  activo
  inactivo
}

enum DocumentoTipo {
  dni
  nie
  cif
  pasaporte
}

enum VehiculoEstado {
  activo
  inactivo
}

model Client {
  id                   String         @id @default(cuid())
  nombre               String
  email                String         @unique
  telefono             String
  telefonoSecundario   String?        @map("telefono_secundario")
  empresa              String?
  notas                String?
  estado               ClienteEstado  @default(activo)
  ultimaVisita         DateTime       @default(now()) @map("ultima_visita") @db.Date
  documentoTipo        DocumentoTipo? @map("documento_tipo")
  documentoNumero      String?        @map("documento_numero")
  direccionLinea1      String?        @map("direccion_linea1")
  direccionLinea2      String?        @map("direccion_linea2")
  direccionCiudad      String?        @map("direccion_ciudad")
  direccionCodigoPostal String?       @map("direccion_codigo_postal")
  direccionProvincia   String?        @map("direccion_provincia")
  vehicles             Vehicle[]
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  @@map("clients")
}

model Vehicle {
  id                   String         @id @default(cuid())
  clientId             String         @map("client_id")
  client               Client         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  matricula            String         @unique
  marca                String
  modelo               String
  anio                 Int
  color                String         @default("—")
  kilometraje          Int            @default(0)
  proximoMantenimiento DateTime       @map("proximo_mantenimiento") @db.Date
  estado               VehiculoEstado @default(activo)
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  @@index([clientId])
  @@map("vehicles")
}
