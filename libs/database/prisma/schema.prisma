generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Placeholder fase 1 — health check del API.
model HealthCheck {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")

  @@map("health_checks")
}

model Role {
  id          String   @id @default(cuid())
  nombre      String
  descripcion String   @default("")
  permisos    String[]
  users       User[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("roles")
}

model User {
  id                String         @id @default(cuid())
  nombre            String
  email             String         @unique
  telefono          String?
  passwordHash      String         @map("password_hash")
  activo            Boolean        @default(true)
  ordenesActivas    Int            @default(0) @map("ordenes_activas")
  passwordChangedAt DateTime?      @map("password_changed_at")
  roleId            String         @map("role_id")
  role              Role           @relation(fields: [roleId], references: [id], onDelete: Restrict)
  refreshTokens     RefreshToken[]
  assignedWorkOrders WorkOrder[]   @relation("WorkOrderAssignedUser")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  @@index([roleId])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

enum ClienteEstado {
  activo
  inactivo
}

enum DocumentoTipo {
  dni
  nie
  cif
  pasaporte
}

enum VehiculoEstado {
  activo
  inactivo
}

model Client {
  id                   String         @id @default(cuid())
  nombre               String
  email                String         @unique
  telefono             String
  telefonoSecundario   String?        @map("telefono_secundario")
  empresa              String?
  notas                String?
  estado               ClienteEstado  @default(activo)
  ultimaVisita         DateTime       @default(now()) @map("ultima_visita") @db.Date
  documentoTipo        DocumentoTipo? @map("documento_tipo")
  documentoNumero      String?        @map("documento_numero")
  direccionLinea1      String?        @map("direccion_linea1")
  direccionLinea2      String?        @map("direccion_linea2")
  direccionCiudad      String?        @map("direccion_ciudad")
  direccionCodigoPostal String?       @map("direccion_codigo_postal")
  direccionProvincia   String?        @map("direccion_provincia")
  vehicles             Vehicle[]
  workOrders           WorkOrder[]
  appointments         Appointment[]
  commercialOrders     CommercialOrder[]
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  @@map("clients")
}

model Vehicle {
  id                   String         @id @default(cuid())
  clientId             String         @map("client_id")
  client               Client         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  matricula            String         @unique
  vin                  String?
  marca                String
  modelo               String
  anio                 Int
  color                String         @default("—")
  kilometraje          Int            @default(0)
  proximoMantenimiento DateTime       @map("proximo_mantenimiento") @db.Date
  estado               VehiculoEstado @default(activo)
  workOrders           WorkOrder[]
  appointments         Appointment[]
  commercialOrders     CommercialOrder[]
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  @@index([clientId])
  @@map("vehicles")
}

model ServiceCatalog {
  id          String        @id @default(cuid())
  nombre      String
  descripcion String        @default("")
  precio      Decimal       @db.Decimal(10, 2)
  duracionMin Int           @default(60) @map("duracion_min")
  categoria   String
  activo      Boolean       @default(true)
  appointments Appointment[]
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  @@index([categoria])
  @@map("service_catalog")
}

enum AppointmentEstado {
  pendiente
  confirmada
  completada
  cancelada
}

model Appointment {
  id          String            @id @default(cuid())
  clientId    String            @map("client_id")
  client      Client            @relation(fields: [clientId], references: [id], onDelete: Restrict)
  vehicleId   String            @map("vehicle_id")
  vehicle     Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  serviceId   String            @map("service_id")
  service     ServiceCatalog    @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  fecha       DateTime          @db.Date
  hora        String
  duracionMin Int               @map("duracion_min")
  estado      AppointmentEstado @default(pendiente)
  notas       String?
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  @@index([clientId])
  @@index([vehicleId])
  @@index([serviceId])
  @@index([fecha])
  @@map("appointments")
}

enum CommercialOrderTipo {
  cotizacion
  factura
}

enum CommercialOrderEstado {
  borrador
  enviada
  aceptada
  rechazada
  convertida
  emitida
  pagada
  vencida
  anulada
}

enum CommercialOrderLineTipo {
  servicio
  pieza
}

model CommercialOrder {
  id            String                  @id @default(cuid())
  numero        String                  @unique
  tipo          CommercialOrderTipo
  estado        CommercialOrderEstado
  clientId      String                  @map("client_id")
  client        Client                  @relation(fields: [clientId], references: [id], onDelete: Restrict)
  vehicleId     String?                 @map("vehicle_id")
  vehicle       Vehicle?                @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  fecha         DateTime                @db.Date
  validezHasta  DateTime?               @map("validez_hasta") @db.Date
  subtotal      Decimal                 @db.Decimal(10, 2)
  iva           Decimal                 @db.Decimal(10, 2)
  total         Decimal                 @db.Decimal(10, 2)
  lineas        CommercialOrderLine[]
  payments      Payment[]
  workOrders    WorkOrder[]
  createdAt     DateTime                @default(now()) @map("created_at")
  updatedAt     DateTime                @updatedAt @map("updated_at")

  @@index([clientId])
  @@index([vehicleId])
  @@index([tipo])
  @@index([estado])
  @@map("commercial_orders")
}

model CommercialOrderLine {
  id                String                  @id @default(cuid())
  commercialOrderId String                  @map("commercial_order_id")
  commercialOrder   CommercialOrder         @relation(fields: [commercialOrderId], references: [id], onDelete: Cascade)
  orden             Int                     @default(0)
  tipo              CommercialOrderLineTipo
  referenciaId      String                  @map("referencia_id")
  descripcion       String
  cantidad          Int
  precioUnitario    Decimal                 @map("precio_unitario") @db.Decimal(10, 2)
  subtotal          Decimal                 @db.Decimal(10, 2)

  @@index([commercialOrderId])
  @@map("commercial_order_lines")
}

enum PaymentMetodo {
  efectivo
  tarjeta
  transferencia
}

model Payment {
  id                String          @id @default(cuid())
  commercialOrderId String          @map("commercial_order_id")
  commercialOrder   CommercialOrder @relation(fields: [commercialOrderId], references: [id], onDelete: Restrict)
  monto             Decimal         @db.Decimal(10, 2)
  fecha             DateTime        @db.Date
  metodo            PaymentMetodo
  referencia        String?
  notas             String?
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  @@index([commercialOrderId])
  @@map("payments")
}

model WorkshopSettings {
  id                  String   @id @default("default")
  nombreTaller        String   @map("nombre_taller")
  cif                 String
  direccion           String
  horaApertura        String   @map("hora_apertura")
  horaCierre          String   @map("hora_cierre")
  bahias              Int      @default(6)
  notifCitas          Boolean  @default(true) @map("notif_citas")
  notifOrdenes        Boolean  @default(true) @map("notif_ordenes")
  notifRecordatorios  Boolean  @default(true) @map("notif_recordatorios")
  serieCotizacion     String   @map("serie_cotizacion")
  serieFactura        String   @map("serie_factura")
  ivaPorcentaje       Decimal  @default(21) @map("iva_porcentaje") @db.Decimal(5, 2)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("workshop_settings")
}

enum InventoryPartEstado {
  activo
  inactivo
}

model InventoryPart {
  id             String              @id @default(cuid())
  codigo         String              @unique
  nombre         String
  categoria      String
  stock          Int                 @default(0)
  stockMinimo    Int                 @default(0) @map("stock_minimo")
  precioUnitario Decimal             @map("precio_unitario") @db.Decimal(10, 2)
  ubicacion      String?
  estado         InventoryPartEstado @default(activo)
  workOrderParts WorkOrderPart[]
  movements      StockMovement[]
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  @@index([categoria])
  @@map("inventory_parts")
}

model StockMovement {
  id              String        @id @default(cuid())
  inventoryPartId String        @map("inventory_part_id")
  inventoryPart   InventoryPart @relation(fields: [inventoryPartId], references: [id])
  tipo            String
  cantidad        Int
  stockAnterior   Int           @map("stock_anterior")
  stockNuevo      Int           @map("stock_nuevo")
  nota            String?
  userId          String?       @map("user_id")
  createdAt       DateTime      @default(now()) @map("created_at")

  @@index([inventoryPartId])
  @@map("stock_movements")
}

enum WorkOrderEstado {
  pendiente
  en_progreso
  esperando_piezas
  completado
}

enum WorkOrderTipo {
  mantenimiento
  reparacion
}

model WorkOrder {
  id               String                    @id @default(cuid())
  numero           String                    @unique
  tipo             WorkOrderTipo
  clientId         String                    @map("client_id")
  client           Client                    @relation(fields: [clientId], references: [id], onDelete: Restrict)
  vehicleId        String                    @map("vehicle_id")
  vehicle          Vehicle                   @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  assignedUserId   String                    @map("assigned_user_id")
  assignedUser     User                      @relation("WorkOrderAssignedUser", fields: [assignedUserId], references: [id], onDelete: Restrict)
  estado           WorkOrderEstado           @default(pendiente)
  descripcion      String
  fechaEntrada     DateTime                  @map("fecha_entrada") @db.Date
  fechaEstimada    DateTime                  @map("fecha_estimada") @db.Date
  totalEstimado    Decimal                   @default(0) @map("total_estimado") @db.Decimal(10, 2)
  ordenComercialId String?                   @map("orden_comercial_id")
  commercialOrder  CommercialOrder?          @relation(fields: [ordenComercialId], references: [id], onDelete: SetNull)
  partsUsed        WorkOrderPart[]
  checklist        WorkOrderChecklistItem[]
  timeline         WorkOrderTimelineEntry[]
  createdAt        DateTime                  @default(now()) @map("created_at")
  updatedAt        DateTime                  @updatedAt @map("updated_at")

  @@index([clientId])
  @@index([vehicleId])
  @@index([assignedUserId])
  @@index([estado])
  @@map("work_orders")
}

model WorkOrderPart {
  id              String        @id @default(cuid())
  workOrderId     String        @map("work_order_id")
  workOrder       WorkOrder     @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  inventoryPartId String        @map("inventory_part_id")
  inventoryPart   InventoryPart @relation(fields: [inventoryPartId], references: [id], onDelete: Restrict)
  cantidad        Int
  precioUnitario  Decimal       @map("precio_unitario") @db.Decimal(10, 2)

  @@index([workOrderId])
  @@index([inventoryPartId])
  @@map("work_order_parts")
}

model WorkOrderChecklistItem {
  id          String    @id @default(cuid())
  workOrderId String    @map("work_order_id")
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  orden       Int       @default(0)
  item        String
  completado  Boolean   @default(false)

  @@index([workOrderId])
  @@map("work_order_checklist_items")
}

model WorkOrderTimelineEntry {
  id          String          @id @default(cuid())
  workOrderId String          @map("work_order_id")
  workOrder   WorkOrder       @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  fecha       DateTime
  estado      WorkOrderEstado
  nota        String

  @@index([workOrderId])
  @@map("work_order_timeline_entries")
}
