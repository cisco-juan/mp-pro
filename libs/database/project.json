{
  "name": "database",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/database/src",
  "projectType": "library",
  "tags": ["type:data-access", "scope:shared"],
  "targets": {
    "prisma-generate": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "libs/database",
        "command": "npx prisma generate"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "libs/database",
        "commands": [
          "npx tsc --build tsconfig.lib.json",
          "node -e \"require('fs').mkdirSync('dist', {recursive:true}); require('fs').writeFileSync('dist/index.js', \\\"export * from './src/index.js';\\\\n\\\")\""
        ]
      },
      "outputs": ["{projectRoot}/dist"]
    },
    "prisma-migrate": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "libs/database",
        "command": "npx prisma migrate dev"
      }
    }
  }
}
